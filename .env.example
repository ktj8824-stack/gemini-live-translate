# Gemini API 키 (서버에만 보관, 절대 커밋 금지)
GEMINI_API_KEY=
# AI 자동학습 모델 (기본: gemini-3.6-flash)
LEARN_MODEL=gemini-3.6-flash
# 다른 도메인에서 서버 API를 쓸 경우 허용할 출처 (쉼표 구분)
ALLOWED_ORIGINS=
# iOS 앱(file://) 요청 허용 여부 (기본 true)
ALLOW_FILE_ORIGIN=true
# Render/Railway 등 프록시 뒤에서 실행 시 1로 설정 (IP별 요청 제한 정확도)
TRUST_PROXY=
PORT=3000
